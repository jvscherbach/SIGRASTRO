# Copie para .env.local (que não é versionado) e ajuste os valores.
# Nenhuma variável é obrigatória: sem as do banco do SIGA o sistema sobe, o login funciona
# e a consulta responde "SIGA indisponível" (veja o README, seção "Conectar ao banco do SIGA").

# --- Usuários padrão (L1) ---
# Criados na subida só se a senha estiver preenchida (mínimo 12 caracteres, sem o login, diferente das outras).
# Não há senha-padrão: sem a variável o usuário não existe. Defina o valor só no seu .env.local.
# RASTRO_SENHA_OPERADOR=
# CPF/CNPJ do interessado do usuário "operador" (obrigatório para ele ser criado).
# RASTRO_OPERADOR_CPF_CNPJ=
# RASTRO_SENHA_ANALISTA=
# CPF do usuário "analista" (vínculo com o Camunda; sem ele a caixa fica vazia).
# RASTRO_ANALISTA_CPF=
# RASTRO_SENHA_ADMIN=

# --- Geração do dossiê ---
# Diretório temporário dos dossiês dentro do container (já montado no volume dossies-tmp).
# VISTAS_DOSSIE_DIRETORIO=/var/tmp/vistas
# DOSSIE_TTL_MINUTOS=30
# DOSSIE_THREADS=2
# Inatividade da leitura do arquivo (segundos sem receber bytes); a conexão tem limite fixo de 10 s.
# DOWNLOAD_TIMEOUT_SEGUNDOS=120
# Teto total para obter um documento, somando as novas tentativas automáticas (até 2, após 2 s e 5 s).
# DOWNLOAD_TOTAL_MAXIMO_SEGUNDOS=900
# Espaço livre mínimo (MB) no volume dossies-tmp antes de cada download; abaixo disso o documento falha.
# DOSSIE_ESPACO_MINIMO_MB=500
# Acima deste tamanho (MB) o dossiê é baixado direto pelo navegador, com ticket de uso único, sem pré-visualização.
# Se "Baixar PDF" falhar com "Não foi possível conectar", tente 20 (docs/10, R61).
# DOSSIE_BLOB_MAX_MB=150
# Horas que um pedido expirado, baixado ou cancelado continua em "Dossiês gerados" (em memória: some ao reiniciar).
# DOSSIE_HISTORICO_HORAS=24
# DOSSIE_SUMARIO=true
# DOSSIE_MARCADORES=true
# DOSSIE_NUMERACAO=true

# --- Conversão para PDF (S3) ---
# Chave de segurança: false volta ao comportamento da S2.2 (só PDF entra no dossiê).
# CONVERSAO_HABILITADA=true
# Tempo máximo de uma conversão, em segundos.
# CONVERSAO_TIMEOUT_SEGUNDOS=300
# Instâncias do conversor em paralelo e tarefas por instância antes de reiniciá-la.
# CONVERSAO_PROCESSOS=2
# CONVERSAO_TAREFAS_POR_PROCESSO=50
# Planilhas: LARGURA (cada aba em 1 página de largura) ou PAGINA_POR_ABA (uma página por aba).
# CONVERSAO_PLANILHA_MODO=LARGURA
# true inclui as abas ocultas no PDF.
# CONVERSAO_ABAS_OCULTAS=false
# Modo LARGURA: abaixo desta escala (%) a aba vai para uma página única, por legibilidade.
# CONVERSAO_PLANILHA_ESCALA_MINIMA=40
# Máximo de páginas do PDF de uma conversão.
# CONVERSAO_PAGINAS_MAXIMAS=2000
# Imagens acima disto (megapixels) são recusadas.
# CONVERSAO_IMAGEM_MAX_MEGAPIXELS=100
# Tamanho máximo (MB) do PDF gerado por uma conversão.
# CONVERSAO_SAIDA_MAX_MB=500
# Pasta do LibreOffice (a que contém program/soffice). Vazia = caminhos padrão (na imagem da api, /usr/lib/libreoffice).
# CONVERSAO_OFFICE_HOME=

# --- Modal de visualização (S3) ---
# Tempo de vida (minutos) e teto (MB) do cache da versão em PDF; acima do teto saem os mais antigos.
# VISUALIZACAO_TTL_MINUTOS=10
# VISUALIZACAO_CACHE_MAX_MB=500
# Conversões do modal em paralelo e quantas esperam a vez; com a fila cheia, 429 MUITAS_CONVERSOES.
# VISUALIZACAO_CONVERSOES_SIMULTANEAS=2
# VISUALIZACAO_FILA_CONVERSOES=4

# --- Geometrias em ZIP (S4) ---
# Tamanho somado máximo (MB) e quantidade máxima de arquivos; acima, 413 GEOMETRIAS_GRANDES_DEMAIS.
# GEOMETRIAS_MAX_MB=500
# GEOMETRIAS_MAX_ARQUIVOS=200

# --- Auditoria em memória (S5) ---
# Teto de eventos somando os dois grupos (acima, saem os mais antigos) e retenção em anos (1, 2, 5 ou 10).
# AUDITORIA_MAX_EVENTOS=50000
# AUDITORIA_RETENCAO_DOCUMENTOS_ANOS=5
# AUDITORIA_RETENCAO_ACESSOS_ANOS=1
# Limite de linhas do CSV da auditoria; acima, corta e avisa.
# AUDITORIA_CSV_MAX_LINHAS=50000

# --- OpenAPI fora do ambiente local ---
# OPENAPI_ENABLED=false

# --- Tarefas agendadas ---
# a partir da S3
# AGENDAMENTO_ENABLED=true

# --- Banco do SIGA (somente leitura) ---
# Usado a partir da S1 (consulta). Preencha as três primeiras com os valores fornecidos pelo DBA.
# Deixe comentadas (ou vazias) para subir sem o SIGA: a consulta responde 503 "SIGA indisponível".
# SIGA_DB_URL=jdbc:oracle:thin:@//host:1521/servico
# SIGA_DB_USER=usuario_leitura
# SIGA_DB_PASSWORD=senha
# Opcionais (valores padrão entre parênteses):
# SIGA_DB_POOL_MAX=2
# SIGA_DB_CONN_TIMEOUT_MS=5000
# SIGA_DB_READ_TIMEOUT_MS=30000
# SIGA_DB_MAX_LIFETIME_MS=1500000

# --- API de arquivos do Licenciamento (S2) ---
# Sem a URL (ausente ou vazia) a lista de documentos funciona e a geração falha com "API de arquivos não configurada".
# ATENÇÃO: linhas do .env.local não podem começar com espaço. O token identifica quem o capturou: uso local, nunca versionar.
# LICENCIAMENTO_API_URL=https://host-da-api-de-arquivos
# LICENCIAMENTO_API_TOKEN=token
# Alternativa (S2.2): caminho, DENTRO do container, de um arquivo só com o token. Relido a cada pedido e a cada
# nova tentativa; tem precedência sobre LICENCIAMENTO_API_TOKEN. Trocar o token = reescrever o arquivo, sem
# recriar o container. Arquivo ausente ou vazio: "API de arquivos não configurada". Veja compose.local.yaml.
# LICENCIAMENTO_API_TOKEN_FILE=/run/secrets-vistas/token-arquivos
# bearer (padrão) ou cookie; no modo cookie informe também o nome do cookie
# LICENCIAMENTO_API_AUTH_MODE=bearer
# LICENCIAMENTO_API_COOKIE_NAME=nome-do-cookie

# --- SCORP (S4): documentos pessoais (origem "Pessoal") ---
# Vazia = desligado: a lista sai sem documentos pessoais e sem aviso.
# SCORP_API_URL=https://host-do-scorp
# Autenticação NÃO CONFIRMADA (P06). Sem as três abaixo, valem as da API de arquivos (LICENCIAMENTO_API_*).
# SCORP_API_TOKEN_FILE=/run/secrets-vistas/token-scorp
# SCORP_API_AUTH_MODE=bearer
# SCORP_API_COOKIE_NAME=nome-do-cookie
# Tempo limite de cada chamada (segundos) e chamadas em paralelo (1 nova tentativa no máximo).
# SCORP_TIMEOUT_SEGUNDOS=15
# SCORP_CHAMADAS_SIMULTANEAS=4
# false (padrão) trata os documentos pessoais como não sigilosos, como a Vista do SIGA; true, todos sigilosos (P30).
# SCORP_SIGILO_PADRAO=false

# --- Teste de conexão (Configurações > Conexões, S6) ---
# Tempo limite de cada chamada do teste (segundos); 503 isolado ganha uma nova tentativa.
# CONEXAO_TESTE_TIMEOUT_SEGUNDOS=15

# --- Servidor MCP do Rastro (Claude Code, S6, bloco 7) ---
# NÃO são lidas daqui pelo servidor MCP: vêm do ambiente do processo (exporte no terminal antes de abrir o Claude Code).
# Só o Rastro local em modo de demonstração (compose.verificacao.yaml); host remoto é recusado.
# RASTRO_MCP_URL=http://localhost:8080
# RASTRO_MCP_USUARIO=
# RASTRO_MCP_SENHA=
# RASTRO_MCP_TIMEOUT_MS=10000
# Modo do serviço: demonstracao só vale sem nenhum sistema externo configurado (o compose.verificacao.yaml liga).
# RASTRO_MODO=padrao

# --- Schema próprio (versão definitiva) ---
# VISTAS_DB_URL=jdbc:oracle:thin:@//host:1521/servico
# VISTAS_DB_USER=usuario_app
# VISTAS_DB_PASSWORD=senha
# VISTAS_DB_POOL_MAX=3
# FLYWAY_ENABLED=false
