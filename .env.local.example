# Copie para .env.local (que não é versionado) e ajuste os valores.
# Nenhuma variável é obrigatória: sem as do banco do SIGA o sistema sobe, o login funciona
# e a consulta responde "SIGA indisponível" (veja o README, seção "Conectar ao banco do SIGA").

# --- Login simulado (opcional) ---
# No perfil local a senha de demonstração já tem um valor padrão; descomente para trocar.
# VISTAS_DEMO_SENHA=

# --- Geração do dossiê ---
# Diretório temporário dos dossiês dentro do container (já montado no volume dossies-tmp).
# VISTAS_DOSSIE_DIRETORIO=/var/tmp/vistas
# DOSSIE_TTL_MINUTOS=30
# DOSSIE_THREADS=2
# Inatividade da leitura do arquivo (segundos sem receber bytes); a conexão tem limite fixo de 10 s.
# DOWNLOAD_TIMEOUT_SEGUNDOS=120
# Teto total para obter um documento, somando as novas tentativas automáticas (até 2, após 2 s e 5 s).
# DOWNLOAD_TOTAL_MAXIMO_SEGUNDOS=900
# Espaço livre mínimo (MB) no volume dossies-tmp antes de cada download; abaixo disso o documento falha.
# DOSSIE_ESPACO_MINIMO_MB=2048
# DOSSIE_SUMARIO=true
# DOSSIE_MARCADORES=true
# DOSSIE_NUMERACAO=true
# a partir da S3
# CONVERSAO_TIMEOUT_SEGUNDOS=120

# --- OpenAPI fora do ambiente local ---
# OPENAPI_ENABLED=false

# --- Tarefas agendadas ---
# a partir da S3
# AGENDAMENTO_ENABLED=true

# --- Banco do SIGA (somente leitura) ---
# Usado a partir da S1 (consulta). Preencha as três primeiras com os valores fornecidos pelo DBA.
# Deixe comentadas (ou vazias) para subir sem o SIGA: a consulta responde 503 "SIGA indisponível".
# SIGA_DB_URL=jdbc:oracle:thin:@//host:1521/servico
# SIGA_DB_USER=usuario_leitura
# SIGA_DB_PASSWORD=senha
# Opcionais (valores padrão entre parênteses):
# SIGA_DB_POOL_MAX=2
# SIGA_DB_CONN_TIMEOUT_MS=5000
# SIGA_DB_READ_TIMEOUT_MS=30000
# SIGA_DB_MAX_LIFETIME_MS=1500000

# --- API de arquivos do Licenciamento (S2) ---
# Sem a URL (ausente ou vazia) a lista de documentos funciona e a geração falha com "API de arquivos não configurada".
# ATENÇÃO: linhas do .env.local não podem começar com espaço. O token identifica quem o capturou: uso local, nunca versionar.
# LICENCIAMENTO_API_URL=https://host-da-api-de-arquivos
# LICENCIAMENTO_API_TOKEN=token
# Alternativa (S2.2): caminho, DENTRO do container, de um arquivo só com o token. Relido a cada pedido e a cada
# nova tentativa; tem precedência sobre LICENCIAMENTO_API_TOKEN. Trocar o token = reescrever o arquivo, sem
# recriar o container. Arquivo ausente ou vazio: "API de arquivos não configurada". Veja compose.local.yaml.
# LICENCIAMENTO_API_TOKEN_FILE=/run/secrets-vistas/token-arquivos
# bearer (padrão) ou cookie; no modo cookie informe também o nome do cookie
# LICENCIAMENTO_API_AUTH_MODE=bearer
# LICENCIAMENTO_API_COOKIE_NAME=nome-do-cookie

# --- SCORP (S4) ---
# SCORP_API_URL=https://host-do-scorp

# --- Schema próprio (versão definitiva) ---
# VISTAS_DB_URL=jdbc:oracle:thin:@//host:1521/servico
# VISTAS_DB_USER=usuario_app
# VISTAS_DB_PASSWORD=senha
# VISTAS_DB_POOL_MAX=3
# FLYWAY_ENABLED=false
