# Copie para .env.local (que não é versionado) e ajuste os valores.
# Nenhuma variável é obrigatória: sem as do banco do SIGA o sistema sobe, o login funciona
# e a consulta responde "SIGA indisponível" (veja o README, seção "Conectar ao banco do SIGA").

# --- Login simulado (opcional) ---
# No perfil local a senha de demonstração já tem um valor padrão; descomente para trocar.
# VISTAS_DEMO_SENHA=

# --- Geração do dossiê ---
# Diretório temporário dos dossiês dentro do container (já montado no volume dossies-tmp).
# VISTAS_DOSSIE_DIRETORIO=/var/tmp/vistas
# a partir da S3
# DOSSIE_TTL_MINUTOS=30
# DOSSIE_THREADS=2
# DOWNLOAD_TIMEOUT_SEGUNDOS=60
# CONVERSAO_TIMEOUT_SEGUNDOS=120

# --- OpenAPI fora do ambiente local ---
# OPENAPI_ENABLED=false

# --- Tarefas agendadas ---
# a partir da S3
# AGENDAMENTO_ENABLED=true

# --- Banco do SIGA (somente leitura) ---
# Usado a partir da S1 (consulta). Preencha as três primeiras com os valores fornecidos pelo DBA.
# Deixe comentadas (ou vazias) para subir sem o SIGA: a consulta responde 503 "SIGA indisponível".
# SIGA_DB_URL=jdbc:oracle:thin:@//host:1521/servico
# SIGA_DB_USER=usuario_leitura
# SIGA_DB_PASSWORD=senha
# Opcionais (valores padrão entre parênteses):
# SIGA_DB_POOL_MAX=2
# SIGA_DB_CONN_TIMEOUT_MS=5000
# SIGA_DB_READ_TIMEOUT_MS=30000
# SIGA_DB_MAX_LIFETIME_MS=1500000

# --- API de arquivos do Licenciamento e SCORP ---
# a partir da S3
# LICENCIAMENTO_API_URL=https://host-da-api-de-arquivos
# LICENCIAMENTO_API_TOKEN=token
# SCORP_API_URL=https://host-do-scorp

# --- Schema próprio (versão definitiva) ---
# VISTAS_DB_URL=jdbc:oracle:thin:@//host:1521/servico
# VISTAS_DB_USER=usuario_app
# VISTAS_DB_PASSWORD=senha
# VISTAS_DB_POOL_MAX=3
# FLYWAY_ENABLED=false
